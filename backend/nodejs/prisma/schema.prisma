generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_chat_messages {
  id                  String               @id @default(uuid()) @db.Uuid
  session_id          String?              @db.Uuid
  sender_type         String?              @db.VarChar(20)
  message_text        String
  extracted_specs     Json?
  sent_at             DateTime?            @default(now()) @db.Timestamptz(6)
  ai_chat_sessions    ai_chat_sessions?    @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ai_drawing_analyses ai_drawing_analyses?
}

model ai_chat_sessions {
  id                 String               @id @default(uuid()) @db.Uuid
  user_id            String?              @db.Uuid
  session_title      String?              @db.VarChar(255)
  started_at         DateTime?            @default(now()) @db.Timestamptz(6)
  ai_chat_messages   ai_chat_messages[]
  users              users?               @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  ai_memory_contexts ai_memory_contexts[]
  quotations         quotations[]
}

model ai_knowledge_base {
  id                    String                 @id @default(uuid()) @db.Uuid
  rule_title            String                 @db.VarChar(255)
  rule_content          String
  embedding_vector      String?
  created_at            DateTime?              @default(now()) @db.Timestamptz(6)
  pattern_id            String?                @db.Uuid
  ai_knowledge_patterns ai_knowledge_patterns? @relation(fields: [pattern_id], references: [id], onUpdate: NoAction)
}

model labor_categories {
  id            String        @id @default(uuid()) @db.Uuid
  category_name String        @db.VarChar(100)
  description   String?
  labor_rates   labor_rates[]
}

model labor_pricing_models {
  id          String        @id @default(uuid()) @db.Uuid
  model_name  String        @db.VarChar(50)
  labor_rates labor_rates[]
}

model labor_rates {
  id                   String                @id @default(uuid()) @db.Uuid
  category_id          String?               @db.Uuid
  model_id             String?               @db.Uuid
  rate_amount          Decimal               @db.Decimal(12, 2)
  updated_at           DateTime?             @default(now()) @db.Timestamptz(6)
  labor_categories     labor_categories?     @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  labor_pricing_models labor_pricing_models? @relation(fields: [model_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([category_id, model_id])
}

model material_thickness {
  id               String            @id @default(uuid()) @db.Uuid
  material_id      String?           @db.Uuid
  thickness_value  String            @db.VarChar(50)
  price_multiplier Decimal           @default(1.00) @db.Decimal(5, 2)
  materials        materials?        @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotation_specs  quotation_specs[]

  @@unique([material_id, thickness_value])
}

model material_types {
  id          String      @id @default(uuid()) @db.Uuid
  type_name   String      @db.VarChar(100)
  description String?
  materials   materials[]
}

model material_units {
  id        String      @id @default(uuid()) @db.Uuid
  unit_name String      @db.VarChar(50)
  materials materials[]
}

model materials {
  id                 String               @id @default(uuid()) @db.Uuid
  type_id            String?              @db.Uuid
  unit_id            String?              @db.Uuid
  material_code      String               @unique @db.VarChar(50)
  material_name      String               @db.VarChar(255)
  base_price         Decimal              @db.Decimal(12, 2)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  material_thickness material_thickness[]
  material_types     material_types?      @relation(fields: [type_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  material_units     material_units?      @relation(fields: [unit_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  quotation_specs    quotation_specs[]
  inventory          inventory?
  inventory_logs     inventory_logs[]
  component_allowed_materials component_allowed_materials[]
}

model order_tracking {
  id                String    @id @default(uuid()) @db.Uuid
  order_id          String?   @db.Uuid
  stage_name        String    @db.VarChar(100)
  stage_description String?
  tracked_at        DateTime? @default(now()) @db.Timestamptz(6)
  orders            orders?   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model orders {
  id                String         @id @default(uuid()) @db.Uuid
  quotation_id      String?        @unique @db.Uuid
  order_code        String         @unique @db.VarChar(50)
  production_status String?        @default("pending_payment") @db.VarChar(50)
  created_at        DateTime?      @default(now()) @db.Timestamptz(6)
  
  // Tiền nong
  total_amount      Decimal?       @db.Decimal(15, 2)
  shipping_fee      Decimal?       @default(0) @db.Decimal(15, 2)
  installation_fee  Decimal?       @default(0) @db.Decimal(15, 2)
  
  // Snapshot thông tin giao hàng (Sao chép từ Profile qua lúc nhấn Đặt Hàng)
  customer_name     String?        @db.VarChar(100)
  customer_phone    String?        @db.VarChar(20)
  shipping_address  String?
  order_notes       String?

  material_requirements Json?      @default("{}")
  
  // Quan hệ
  user_id           String?        @db.Uuid
  invoices          invoices?
  order_items       order_items[]
  order_tracking    order_tracking[]
  quotations        quotations?    @relation(fields: [quotation_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users             users?         @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  transactions      transactions[]
}

model paint_types {
  id              String            @id @default(uuid()) @db.Uuid
  paint_name      String            @db.VarChar(100)
  price_per_sqm   Decimal           @db.Decimal(12, 2)
  description     String?
  quotation_specs quotation_specs[]
}

model permissions {
  id               String             @id @default(uuid()) @db.Uuid
  permission_name  String             @unique @db.VarChar(100)
  description      String?
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
}

model product_images {
  id          String    @id @default(uuid()) @db.Uuid
  product_id  String?   @db.Uuid
  image_url   String
  is_primary  Boolean?  @default(false)
  uploaded_at DateTime? @default(now()) @db.Timestamptz(6)
  products    products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model product_categories {
  id              String               @id @default(uuid()) @db.Uuid
  parent_id       String?              @db.Uuid
  category_code   String               @unique @db.VarChar(50)
  category_name   String               @db.VarChar(255)
  description     String?
  created_at      DateTime?            @default(now()) @db.Timestamptz(6)
  parent_category product_categories?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sub_categories  product_categories[] @relation("CategoryHierarchy")
  products        products[]
}

model products {
  id                 String              @id @default(uuid()) @db.Uuid
  product_code       String              @unique @db.VarChar(50)
  product_name       String              @db.VarChar(255)
  default_specs      Json?
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  category_id        String?             @db.Uuid
  components         Json?               @default("[]")
  price_adjustment   Decimal?            @default(0) @db.Decimal(12, 2)
  description        String?
  base_price         Decimal?            @default(0) @db.Decimal(15, 2)
  cart_items         cart_items[]
  order_items        order_items[]
  product_images     product_images[]
  product_categories product_categories? @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model quotation_attachments {
  id           String      @id @default(uuid()) @db.Uuid
  quotation_id String?     @db.Uuid
  file_name    String      @db.VarChar(255)
  file_url     String
  uploaded_at  DateTime?   @default(now()) @db.Timestamptz(6)
  quotations   quotations? @relation(fields: [quotation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model quotation_specs {
  id                 String              @id @default(uuid()) @db.Uuid
  quotation_id       String?             @db.Uuid
  material_id        String?             @db.Uuid
  thickness_id       String?             @db.Uuid
  paint_id           String?             @db.Uuid
  dimensions         Json
  snapshot_price     Decimal             @db.Decimal(12, 2)
  note               String?
  component_name     String?             @db.VarChar(255)
  materials          materials?          @relation(fields: [material_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  paint_types        paint_types?        @relation(fields: [paint_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  quotations         quotations?         @relation(fields: [quotation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  material_thickness material_thickness? @relation(fields: [thickness_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model quotations {
  id                    String                  @id @default(uuid()) @db.Uuid
  user_id               String?                 @db.Uuid
  session_id            String?                 @db.Uuid
  total_quoted_price    Decimal                 @db.Decimal(15, 2)
  admin_proposed_price  Decimal?                @db.Decimal(15, 2) 
  user_proposed_price   Decimal?                @db.Decimal(15, 2)
  status                String?                 @default("draft") @db.VarChar(50)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  title                 String?                 @db.VarChar(255)
  nick_name             String?                 @db.VarChar(255)
  cart_items            cart_items[]
  orders                orders?
  quotation_attachments quotation_attachments[]
  quotation_specs       quotation_specs[]
  ai_chat_sessions      ai_chat_sessions?       @relation(fields: [session_id], references: [id], onUpdate: NoAction)
  users                 users?                  @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  transactions          transactions[]
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model roles {
  id               String             @id @default(uuid()) @db.Uuid
  role_name        String             @unique @db.VarChar(50)
  description      String?
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
  users            users[]
}

model transactions {
  id               String      @id @default(uuid()) @db.Uuid
  quotation_id     String?     @db.Uuid
  transaction_code String      @unique @db.VarChar(100)
  amount           Decimal     @db.Decimal(15, 2)
  payment_method   String?     @db.VarChar(50)
  status           String?     @default("pending") @db.VarChar(50)
  paid_at          DateTime?   @db.Timestamptz(6)
  order_id         String?     @db.Uuid
  orders           orders?     @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  quotations       quotations? @relation(fields: [quotation_id], references: [id], onUpdate: NoAction)
}

model user_profiles {
  user_id      String    @id @db.Uuid
  first_name   String    @db.VarChar(50)
  middle_name  String?   @db.VarChar(50)
  last_name    String    @db.VarChar(50)
  phone_number String?   @db.VarChar(20)
  address      String?
  zalo_number  String?   @db.VarChar(20)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  nickname     String?   @db.VarChar(100)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                String             @id @default(uuid()) @db.Uuid
  role_id           String?            @db.Uuid
  username          String             @unique @db.VarChar(50)
  password_hash     String
  email             String             @unique @db.VarChar(100)
  is_active         Boolean?           @default(true)
  is_verified       Boolean            @default(false)
  verification_code String?            @db.VarChar(10)
  code_expires_at   DateTime?          @db.Timestamptz(6)
  refresh_token     String?
  created_at        DateTime?          @default(now()) @db.Timestamptz(6)
  last_login_at     DateTime?          @db.Timestamptz(6)
  ai_chat_sessions  ai_chat_sessions[]
  orders            orders[]
  quotations        quotations[]
  shopping_carts    shopping_carts[]
  user_profiles     user_profiles?
  roles             roles?             @relation(fields: [role_id], references: [id], onUpdate: NoAction)
}

model order_items {
  id         String    @id @default(uuid()) @db.Uuid
  order_id   String    @db.Uuid
  product_id String    @db.Uuid
  quantity   Int       @default(1)
  price      Decimal   @db.Decimal(12, 2)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  orders     orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model import_batches {
  id                  String                @id @default(uuid()) @db.Uuid
  batch_type          String                @db.VarChar(50)
  status              String                @default("PENDING") @db.VarChar(50)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  file_name           String?               @db.VarChar(255)
  product_imports_tmp product_imports_tmp[]
}

model product_imports_tmp {
  id                String         @id @default(uuid()) @db.Uuid
  batch_id          String         @db.Uuid
  raw_data          String
  validation_status String         @db.VarChar(20)
  validation_errors Json?
  created_at        DateTime?      @default(now()) @db.Timestamptz(6)
  import_batches    import_batches @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model shopping_carts {
  id         String       @id @default(uuid()) @db.Uuid
  user_id    String?      @db.Uuid
  created_at DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at DateTime?    @default(now()) @updatedAt @db.Timestamptz(6)
  cart_items cart_items[]
  users      users?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model cart_items {
  id             String         @id @default(uuid()) @db.Uuid
  cart_id        String         @db.Uuid
  product_id     String?        @db.Uuid
  quotation_id   String?        @db.Uuid
  quantity       Int            @default(1)
  price          Decimal        @db.Decimal(12, 2)
  created_at     DateTime?      @default(now()) @db.Timestamptz(6)
  shopping_carts shopping_carts @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products       products?      @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotations     quotations?    @relation(fields: [quotation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model invoices {
  id                String    @id @default(uuid()) @db.Uuid
  order_id          String?   @unique @db.Uuid
  invoice_no        String    @unique @db.VarChar(100)
  total_amount      Decimal   @db.Decimal(15, 2)
  pdf_url           String?
  email_sent_status String?   @default("pending") @db.VarChar(20)
  sent_at           DateTime? @db.Timestamptz(6)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  orders            orders?   @relation(fields: [order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model ai_drawing_analyses {
  id               String            @id @default(uuid()) @db.Uuid
  message_id       String?           @unique @db.Uuid
  drawing_name     String            @db.VarChar(255)
  image_url        String
  specifications   Json
  scale_ratio      String?           @db.VarChar(50)
  analyzed_at      DateTime?         @default(now()) @db.Timestamptz(6)
  ai_chat_messages ai_chat_messages? @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ai_memory_contexts {
  id                         String            @id @default(uuid()) @db.Uuid
  session_id                 String?           @db.Uuid
  summary_text               String
  last_message_id_summarized String?           @db.Uuid
  token_count                Int?
  created_at                 DateTime?         @default(now()) @db.Timestamptz(6)
  ai_chat_sessions           ai_chat_sessions? @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ai_knowledge_patterns {
  id                 String              @id @default(uuid()) @db.Uuid
  pattern_name       String              @unique @db.VarChar(100)
  trigger_keywords   Json
  response_structure String
  is_active          Boolean?            @default(true)
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  ai_knowledge_base  ai_knowledge_base[]
}
model inventory {
  id              String    @id @default(uuid()) @db.Uuid
  material_id     String    @unique @db.Uuid // Unique vì mỗi vật tư chỉ có 1 dòng tổng tồn kho
  quantity        Decimal   @default(0) @db.Decimal(12, 2) // Số lượng hiện có để sản xuất
  leftover_amount Decimal   @default(0) @db.Decimal(12, 2) // Số lượng vụn/thừa có thể tái chế
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  materials       materials @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
model inventory_logs {
  id               String    @id @default(uuid()) @db.Uuid
  material_id      String    @db.Uuid
  action_type      String    @db.VarChar(50) // Phân loại: 'IMPORT' (Nhập), 'EXPORT' (Xuất), 'WASTE' (Hao phí)
  quantity_change  Decimal   @db.Decimal(12, 2) // Số lượng thay đổi (dương là nhập, âm là xuất)
  reference_code   String?   @db.VarChar(100) // Mã tham chiếu (VD: Mã đơn hàng #ORD-123, Mã phiếu nhập)
  note             String?   // Ghi chú (VD: "Xuất kho cho đơn hàng A", "Nhập hàng từ nhà cung cấp")
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  
  materials        materials @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model component_templates {
  id                    String      @id @default(uuid()) @db.Uuid
  component_name        String      @db.VarChar(255)
  category_code         String?     @db.VarChar(50) 
  default_length        Decimal?    @db.Decimal(12, 2)
  default_width         Decimal?    @db.Decimal(12, 2)
  default_height        Decimal?    @db.Decimal(12, 2)
  default_unit          String      @default("mm") @db.VarChar(20)
  allow_paint           Boolean     @default(true)
  created_at            DateTime?   @default(now()) @db.Timestamptz(6)
  
  allowed_materials     component_allowed_materials[]
}

model component_allowed_materials {
  component_id String              @db.Uuid
  material_id  String              @db.Uuid
  default_waste Decimal?           @default(0) @db.Decimal(10, 2)
  
  components   component_templates @relation(fields: [component_id], references: [id], onDelete: Cascade)
  materials    materials           @relation(fields: [material_id], references: [id], onDelete: Cascade)

  @@id([component_id, material_id])
}